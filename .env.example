# ---- 収益化の設定（GitHub の Variables に登録。すべて任意。未設定ならその機能は無効） ----
# サイトの公開URL（sitemap / OGP / 楽天APIのReferer に使用）
NEXT_PUBLIC_SITE_URL=https://asahi-gakushu.github.io/Javabronze-app
# 楽天アフィリエイトID（商品リンク・検索リンクが紹介料の対象になる）
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=
# Amazon アソシエイトのトラッキングID（例: yourid-22）
NEXT_PUBLIC_AMAZON_TAG=
# Google AdSense のパブリッシャーIDと広告ユニットID
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
# Google Analytics 4 の測定ID
NEXT_PUBLIC_GA_ID=
# お問い合わせフォームのURL（Googleフォームなど。ASPの審査で求められることが多い）
NEXT_PUBLIC_CONTACT_URL=

# ---- コンテンツボット（GitHub の Secrets に登録） ----
ANTHROPIC_API_KEY=
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
