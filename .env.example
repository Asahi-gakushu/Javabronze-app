# ---- 収益化の設定（すべて任意。未設定なら該当ブロックは表示されません） ----
# サイトの公開URL（sitemap / OGP 用）
NEXT_PUBLIC_SITE_URL=https://asahi-gakushu.github.io/Javabronze-app
# Google AdSense のパブリッシャーID（例: ca-pub-1234567890123456）
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense 広告ユニットのスロットID
NEXT_PUBLIC_ADSENSE_SLOT=
# Amazon アソシエイトのトラッキングID（例: yourid-22）
NEXT_PUBLIC_AMAZON_TAG=
# 応援・有料コンテンツ用の決済リンク（Stripe Payment Link / Buy Me a Coffee / Ko-fi など）
NEXT_PUBLIC_SUPPORT_URL=
# Google Analytics 4 の測定ID（例: G-XXXXXXX）
NEXT_PUBLIC_GA_ID=

# ---- 問題自動生成ボット（GitHub Actions の Secret に設定） ----
ANTHROPIC_API_KEY=
